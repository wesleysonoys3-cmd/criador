GOOGLE_API_KEY=sua_chave_api_aqui
GOOGLE_MODEL=gemini-3.5-flash-lite
WORK_DIR=./workspace
MAX_STEPS=15

# ==========================================================================
#  RC22 · MULTI-IA 3 FASES (Arquiteta → Desenvolvedora → QA)
#  Tudo desligado por padrão (compatibilidade 100% com o fluxo antigo)
#  Para ativar: PIPELINE_3IA=on
# ==========================================================================

# Liga/desliga o pipeline de 3 fases. DEFAULT = off (modo antigo, só Gemini)
# PIPELINE_3IA=off

# ---------- Chaves das IAs (se vazias, cai AUTOMATICAMENTE no Gemini, sem erro) ----------
# Cerebras Cloud (llama 70B default): https://cloud.cerebras.ai
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama3.1-70b

# Mistral API: https://console.mistral.ai
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# OpenRouter (DeepSeek GRATUITO via free tier): https://openrouter.ai
# OPENROUTER_API_KEY=
# OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-chat:free

# DeepSeek OFICIAL (PAGO — só ativar se tiver saldo, NÃO cobra automaticamente)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_PAID_MODE=off   # só liga se tiver saldo e quiser usar pago

# ---------- Quem executa cada fase (default = Gemini para TODAS) ----------
# ARCH_PROVIDER=gemini     # cerebras | mistral | openrouter | deepseek | gemini
# ARCH_MODEL=gemini-3.5-flash-lite

# DEV_PROVIDER=gemini      # PRESERVAR GEMINI por padrão (motor estável)
# DEV_MODEL=gemini-3.5-flash-lite

# QA_PROVIDER=gemini       # gemini | mistral | cerebras | openrouter | deepseek
# QA_MODEL=gemini-2.5-flash

# ---------- Ajustes finos do pipeline ----------
# MAX_ARCH_RETRIES=2       # tentativas da Arquiteta se JSON inválido
# QA_MAX_ISSUES=12         # max issues no relatório QA
# MAX_CORRECTION_LOOPS=0   # (RC23 futuro) padrão = 0 (não corrige automaticamente)

# ==========================================================================
#  RC27 · TELA DE CONFIGURAÇÃO DAS CHAVES VIA UI (não precisa editar este arquivo)
#  Abra o TiAi no navegador → aba "IA Config" no centro (entre Terminal e Code)
#  Lá você cola as chaves, testa cada uma com o botão "Conectar" (ping real na API)
#  e depois clica em "💾 Salvar no .env" — este arquivo é atualizado automaticamente
#  com backup (3 últimas versões em .env.bak.<timestamp>) sem perder nenhuma outra
#  variável personalizada (GOOGLE_MODEL, WORK_DIR etc). Segurança: a chave NUNCA
#  volta completa do backend para o frontend — só os 5 primeiros + 2 últimos caracteres
#  como confiança visual (ex: AQ.Ab…Zw).
# ==========================================================================

# ==========================================================================
#  LAN BIND · Remote Agent / Gateway (conexão com 2º computador físico na rede)
#  Por padrão por segurança o TiAgente só ouve em 127.0.0.1 (loopback local).
#  Para permitir conexão de Workers/Remote Agents na mesma rede LAN, use UMA das opções:
#
#  OPÇÃO A (recomendada, escuta em TODAS as interfaces):
#    LISTEN_HOST=0.0.0.0
#
#  OPÇÃO B (mais restrita, escuta APENAS no IP LAN específico do Mac principal):
#    LISTEN_HOST=192.168.1.244
#
#  OPÇÃO C (compatível com documentação antiga, liga modo headless LAN + porta extra previews single-port):
#    IS_RENDER_OR_HEADLESS_LINUX=1
#
#  Prioridade: LISTEN_HOST > IS_RENDER_OR_HEADLESS_LINUX > padrão 127.0.0.1
#  Não esqueça de configurar o mesmo REMOTE_GATEWAY_TOKEN no PC remoto.
# ==========================================================================

# LISTEN_HOST=0.0.0.0
# IS_RENDER_OR_HEADLESS_LINUX=1
# REMOTE_GATEWAY_TOKEN=escolha-uma-senha-forte-aleatoria-aqui
# REMOTE_GATEWAY_TOKEN também serve para autenticar o Remote Agent do 2º PC (mesmo valor nos dois lados)

# ==========================================================================

# ==========================================================================
#  RC27 · ORQUESTRADOR AUTÔNOMO (recebe objetivo → decide tudo sozinho)
#  Tudo desligado por padrão (retrocompatibilidade 100% absoluta com RC22–RC26)
#  Para ativar: RC27_AUTONOMOUS_MODE=on
# ==========================================================================

# Liga/desliga o Orquestrador Autônomo. DEFAULT = off (100% igual antes, zero overhead)
RC27_AUTONOMOUS_MODE=off

# Número MÁXIMO de passos do orquestrador antes de pausar (evita loops de planejamento)
RC27_DEFAULT_MAX_STEPS=25

# Número MÁXIMO de iterações de correção por bug encontrado nos testes (§17 anti-loop infinito)
RC27_MAX_CORRECTION_PASSES=4

# Permite acesso automático à internet sem pedir autorização? DEFAULT = off (§9 NÃO acessa sem perguntar)
RC27_ALLOW_INTERNET_BY_DEFAULT=off

# Salva checkpoint do Estado Central a cada N tool calls executadas (§16 checkpoint + recuperação)
RC27_SAVE_EVERY_N_TOOL_CALLS=3

# ==========================================================================
#  RC28 · MECANISMO DE DECISÃO AUTÔNOMA (camada ACIMA do RC27, NÃO o substitui)
#  Tudo desligado por padrão (retrocompatibilidade 100% absoluta com RC22–RC27)
#  RC28 acrescenta: loop de decisão interno (G01), decisor heurístico + RC24
#  bridge (G02/G03/G09), executor tarefa-a-tarefa (G04/G05), log decisões
#  (G06), await WS retorno (G07), gate conclusão §19 (G08).
#  Para ativar: RC28_DECISION_ENGINE=on + RC27_AUTONOMOUS_MODE=on
# ==========================================================================

# Liga/desliga o Engine de Decisão RC28. DEFAULT=off (retrocompat 100%)
RC28_DECISION_ENGINE=off

# Número MÁXIMO de ciclos do loop RC28 (§17 anti-loop infinito). DEFAULT=40
RC28_MAX_CYCLES=40

# Se true: SEMPRE invoca o loop RC28 após ARCHITECTURE. Se false: cai no
# fallback legado se o loop concluir sem avançar. DEFAULT=false
RC28_FORCE_RUN_AFTER_PLAN=false

# Salva checkpoint automático a cada N ciclos. DEFAULT=5
RC28_CHECKPOINT_EVERY_CYCLES=5

# Ativa log verbose de decisões (cada step do loop). DEFAULT=false
RC28_VERBOSE_LOG=false

# ======================================================
# RC28.1 · DECISION ENGINE ADAPTATIVO (camada inteligente)
# Duas camadas:
#   (a) heuristic → ZERO-LLM, custo zero, 100% previsível (SAFE DEFAULT)
#   (b) adaptive  → heurística rápida primeiro, LLM só quando
#                    confiança heurística < RC28_ENGINE_CONFIDENCE
#                    (custo variável, capacidade adaptativa máxima)
# DEFAULT=heuristic (comportamento idêntico à RC28 original)
# ======================================================
RC28_ENGINE=heuristic

# Confiança mínima da heurística para pular o LLM (apenas engineMode=adaptive).
# 0.7 = 70%. Abaixo disso, se llmAnalyzeFn for fornecido, o Engine enriquece
# a análise com o LLM antes de decidir. DEFAULT=0.7
RC28_ENGINE_CONFIDENCE=0.7

# Número MÁXIMO de estratégias DIFERENTES tentadas antes de abortar e
# pedir ajuda humana. Evita "dança de estratégias" sem progresso. DEFAULT=3
RC28_MAX_STRATEGIES=3


