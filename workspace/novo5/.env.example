# ============================================================
#  Ajeita AI · Arquivo de Exemplo de Variáveis de Ambiente
#  Copie este arquivo para ".env" e preencha os valores reais.
#  NÃO compartilhe o arquivo .env nem faça commit dele.
# ============================================================

# ---- Porta do servidor Web ----
PORT=3000
NODE_ENV=production

# ============================================================
#  FIREBASE ADMIN SDK (Backend · Service Account)
#  Obrigatório para: verifyIdToken (login admin), Firestore, Storage
#  Como obter: Console Firebase → Configurações do projeto →
#    Contas de serviço → Gerar nova chave privada (JSON)
#  Salve o JSON em uma pasta FORA do workspace (ex: ~/secrets/)
#  e cole o CAMINHO ABSOLUTO abaixo.
# ============================================================
FIREBASE_SERVICE_ACCOUNT=/caminho/absoluto/para/service-account-ajeita-ai.json

# ============================================================
#  FIREBASE CLIENT SDK (Frontend · Dados públicos)
#  Esses valores NÃO são secretos — aparecem no HTML.
#  Como obter: Console Firebase → Configurações do projeto →
#    Seus apps → Web app → Configuração do SDK (npm/CDN)
# ============================================================
FIREBASE_API_KEY=AIza...................................
FIREBASE_AUTH_DOMAIN=ajeita-ai.firebaseapp.com
FIREBASE_PROJECT_ID=ajeita-ai
FIREBASE_STORAGE_BUCKET=ajeita-ai.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890

# ============================================================
#  ADMIN UIDs (FallBack Local · Apenas se Firestore OFFLINE)
#  Lista separada por vírgula dos UIDs dos usuários administradores.
#  Quando o Firebase estiver conectado, a lista verdadeira é
#  lida de  Firestore →  coleção "config" → doc "admin" → campo "adminUids[]"
#  (Esse array aqui SÓ é usado em modo offline fallback.)
# ============================================================
# ADMIN_UIDS=uid_admin_1,uid_admin_2
