# ===============================================
#  TiAgente Security · Configuração (NÃO commitar este arquivo)
# ===============================================

# Porta onde o Security roda SEU PRÓPRIO servidor (não conflita com criador 3000)
SECURITY_PORT=3400

# IP bind (0.0.0.0 = LAN público, 127.0.0.1 = só local)
HOST=127.0.0.1

# (OPCIONAL) Chave Gemini para RESUMOS INTELIGENTES da auditoria (se vazio,
# o Security funciona 100% com heurística local, sem custo).
# Mesma chave do criador pode ser usada aqui (RC20).
GOOGLE_API_KEY=

# (OPCIONAL) Mesmos providers do RC22 se quiser expandir depois.
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# Caminho absoluto do workspace do TiAgente CRIADOR (para listar projetos)
# Por padrão aponta para a pasta irmã ../workspace (relativo ao Security).
CRIADOR_WORKSPACE=../workspace
CRIADOR_MOUNTED_JSON=../mounted_projects.json
CRIADOR_PORTS_JSON=../project_ports.json

# Se false: NUNCA aplica correções automáticas sem checkbox marcado.
SECURITY_AUTO_APPLY_NON_CRITICAL=false
